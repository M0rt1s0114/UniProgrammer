{
  "productName": "UniProgrammer",
  "mainBinaryName": "uniprog",
  "version": "0.4.0-alpha.9",
  "identifier": "com.uniprogrammer.app",
  "build": {
    "frontendDist": "unipkg://localhost/uni.tauri/",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-bundle.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "UniProgrammer",
        "width": 960,
        "height": 880,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["chiplib.bin", "CH34X.DLL", "plugins"]
  }
}
