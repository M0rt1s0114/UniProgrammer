{
  "name": "uniprog",
  "private": true,
  "version": "0.4.0-alpha.12",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.cjs",
    "dev:tauri": "vite --config src-tauri/plugins/builtin/upt.tauri/vite.config.js",
    "dev:hexview": "vite --config src-tauri/plugins/builtin/upt.tauri.hexview/vite.config.js",
    "build": "npm run build:tauri && npm run build:hexview",
    "build:tauri": "vite build --config src-tauri/plugins/builtin/upt.tauri/vite.config.js",
    "build:hexview": "vite build --config src-tauri/plugins/builtin/upt.tauri.hexview/vite.config.js",
    "preview": "vite preview --config src-tauri/plugins/builtin/upt.tauri/vite.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assemble": "node tools/assemble.mjs",
    "assemble:libusb": "node tools/assemble.mjs --profile desktop-tauri-libusb",
    "assemble:dll": "node tools/assemble.mjs --profile desktop-tauri-dll",
    "verify:libusb": "node tools/verify.mjs --profile desktop-tauri-libusb",
    "verify:dll": "node tools/verify.mjs --profile desktop-tauri-dll",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "pinia": "^3.0.4",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "smol-toml": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
